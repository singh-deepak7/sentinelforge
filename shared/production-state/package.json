{
  "name": "@sentinelforge/production-state",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared production simulation state for SentinelForge MCP servers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
