    "build": "npm run clean && tsc",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
